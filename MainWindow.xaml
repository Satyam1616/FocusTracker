<Window x:Class="FocusTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusTracker" Height="660" Width="980" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="0">
            <DockPanel Margin="16,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Border CornerRadius="9">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF7B5E" Offset="0"/>
                                        <GradientStop Color="#EF4E3B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Ellipse Width="18" Height="18" Stroke="White" StrokeThickness="3.2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="5.2" Height="5.2" Fill="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="FocusTracker" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Offline time &amp; focus" Style="{StaticResource Muted}" Margin="2,4,0,24"/>
                    <RadioButton x:Name="NavTimer" Style="{StaticResource NavButton}" GroupName="nav"
                                 Content="⏱   Timer" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDash" Style="{StaticResource NavButton}" GroupName="nav"
                                 Content="📊   Dashboard" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="nav"
                                 Content="⚙   Settings" Checked="Nav_Checked"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource Muted}"
                           TextWrapping="Wrap" Text="All data stays on this PC. Nothing is uploaded."/>
            </DockPanel>
        </Border>

        <!-- Content host -->
        <Grid Grid.Column="1" Margin="10">
            <ContentControl x:Name="TimerHost"/>
            <ContentControl x:Name="DashHost" Visibility="Collapsed"/>
            <ContentControl x:Name="SettingsHost" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
