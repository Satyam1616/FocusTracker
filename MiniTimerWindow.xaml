<Window x:Class="FocusTracker.MiniTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusTracker" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style x:Key="MiniBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource TrackBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Width="212" CornerRadius="16" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource TrackBrush}" BorderThickness="1" MouseLeftButtonDown="Root_Drag">
        <StackPanel Margin="16,12,16,14">
            <Grid>
                <TextBlock x:Name="PhaseLabel" Text="{Binding PhaseText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <Button x:Name="RestoreBtn" Content="⤢" HorizontalAlignment="Right" Click="Restore_Click"
                        Style="{StaticResource MiniBtn}" Padding="7,2" ToolTip="Back to full window"/>
            </Grid>
            <TextBlock Text="{Binding TimeText}" FontSize="42" FontWeight="Bold" Margin="0,2,0,8"/>
            <ProgressBar x:Name="Bar" Style="{StaticResource MiniBar}" Height="6" Minimum="0" Maximum="1"
                         Value="{Binding ProgressFraction, Mode=OneWay}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="StartBtn" Content="Start" Click="StartPause_Click"
                        Style="{StaticResource MiniBtn}" MinWidth="78"/>
                <Button Content="Skip" Click="Skip_Click" Style="{StaticResource MiniBtn}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
