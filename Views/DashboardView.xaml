<UserControl x:Class="FocusTracker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DashBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource TrackBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="5" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    CornerRadius="5" Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <!-- Header with day navigation -->
            <Grid Margin="4,4,4,16">
                <TextBlock Text="Dashboard" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀" Style="{StaticResource GhostButton}" Click="Prev_Click" Padding="12,8"/>
                    <TextBlock x:Name="DateLabel" Text="Today" VerticalAlignment="Center" FontWeight="SemiBold"
                               MinWidth="150" TextAlignment="Center" Margin="6,0"/>
                    <Button Content="▶" Style="{StaticResource GhostButton}" Click="Next_Click" Padding="12,8"/>
                    <Button Content="Today" Style="{StaticResource GhostButton}" Click="Today_Click" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Summary cards -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="ACTIVE TIME" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="ActiveText" Text="0m" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="FOCUS TIME" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="FocusText" Text="0m" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="SESSIONS" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="SessionsText" Text="0" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4">
                    <StackPanel>
                        <TextBlock Text="IDLE TIME" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="IdleText" Text="0m" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <!-- PLACEHOLDER_APPEND -->
            <Border Style="{StaticResource Card}" Margin="4,12,4,4">
                <StackPanel>
                    <TextBlock Text="Where your time went" Style="{StaticResource Heading}"
                               FontSize="16" Margin="0,0,0,14"/>
                    <ItemsControl x:Name="AppsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="78"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding AppName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource DashBar}" Height="10"
                                                 Minimum="0" Maximum="100" Value="{Binding BarPercent, Mode=OneWay}"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyApps" Text="No activity recorded for this day yet."
                               Style="{StaticResource Muted}" Visibility="Collapsed" Margin="0,4"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="4,12,4,4">
                <StackPanel>
                    <TextBlock Text="Active time · last 7 days" Style="{StaticResource Heading}"
                               FontSize="16" Margin="0,0,0,16"/>
                    <StackPanel x:Name="TrendPanel" Orientation="Horizontal" Height="140"
                                HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
