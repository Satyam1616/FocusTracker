<UserControl x:Class="FocusTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush2}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" MaxWidth="580" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Heading}" Margin="4,4,0,14"/>

            <Border Style="{StaticResource Card}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Timer lengths (minutes)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,6">
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" x:Name="WorkBox"/>
                        <TextBlock Text="Focus session" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,6">
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" x:Name="ShortBox"/>
                        <TextBlock Text="Short break" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,6">
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" x:Name="LongBox"/>
                        <TextBlock Text="Long break" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,6">
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" x:Name="IntervalBox"/>
                        <TextBlock Text="Focus sessions before a long break" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <!-- PLACEHOLDER_APPEND -->
            <Border Style="{StaticResource Card}" Margin="4,12,4,0">
                <StackPanel>
                    <TextBlock Text="Activity tracking" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,6">
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource Field}" x:Name="IdleBox"/>
                        <TextBlock Text="Count as idle after (seconds without input)" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="4,12,4,0">
                <StackPanel>
                    <TextBlock Text="Behavior" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="AutoChk" Content="Automatically start the next phase"
                              Foreground="{StaticResource TextBrush}" Margin="0,4"/>
                    <CheckBox x:Name="SoundChk" Content="Play a chime when a phase ends"
                              Foreground="{StaticResource TextBrush}" Margin="0,4"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="4,18,0,0" VerticalAlignment="Center">
                <Button Content="Save changes" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                <TextBlock x:Name="SavedMsg" Text="" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource BreakBrush}" FontWeight="SemiBold"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,16,0,0"
                       Text="Your data is stored locally in %APPDATA%\FocusTracker and never leaves this computer."/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
